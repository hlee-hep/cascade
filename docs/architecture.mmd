flowchart TB
    %% ------------------------------------------------------------------
    %% User-facing entry points
    %% ------------------------------------------------------------------
    subgraph SURFACES["User surfaces"]
        direction TB
        PYUSER["Python analysis"]
        CLI["cascade CLI<br/>module · dag · doctor · macro"]
        ROOTMACRO["ROOT macro"]
    end

    subgraph APIS["Language adapters"]
        direction TB
        PYAPI["py_amcm<br/>supported Python API"]
        BINDING["_cascade<br/>pybind11 bindings"]
        PYADAPTER["base_module<br/>Python callback adapter"]
        ROOTAPI["ROOT / PyROOT dictionaries"]
    end

    PYUSER --> PYAPI --> BINDING
    CLI --> PYAPI
    CLI --> ROOTAPI
    ROOTMACRO --> ROOTAPI

    %% ------------------------------------------------------------------
    %% Verified plugin boundary
    %% ------------------------------------------------------------------
    subgraph PLUGINS["Verified plugin boundary"]
        direction TB
        PREFIXES["Runtime + persistent prefixes<br/>config.json"]
        DISCOVERY["Package discovery<br/>C++ and Python roots"]
        VERIFY["PluginVerifier<br/>path boundary · manifest · SHA-256 · trust"]
        CPPABI["C++ ABI 3 gate<br/>compiler · stdlib · C++ mode · ROOT"]
        CPPLIB["Verified native library<br/>CascadeRegisterPlugin()"]
        PYIMPORT["Verified Python artifact<br/>restricted class import"]
        INDEX["Unified module index<br/>metadata + duplicate-name checks"]

        PREFIXES --> DISCOVERY --> VERIFY
        VERIFY --> CPPABI --> CPPLIB --> INDEX
        VERIFY --> PYIMPORT --> INDEX
    end

    CLI -.->|doctor plugins| VERIFY

    %% ------------------------------------------------------------------
    %% C++ control plane
    %% ------------------------------------------------------------------
    subgraph CONTROL["C++ control plane"]
        direction TB
        AMCM["AMCM<br/>registration + orchestration"]
        REGISTRY["AnalysisModuleRegistry<br/>factories + metadata"]
        DAG["DAGManager<br/>dependencies · lanes · data links"]
        WORKER["Isolated worker supervisor<br/>process limits + result IPC"]

        AMCM --> REGISTRY
        AMCM --> DAG
        AMCM --> WORKER
    end

    BINDING --> AMCM
    INDEX --> REGISTRY
    PYIMPORT --> PYADAPTER

    %% ------------------------------------------------------------------
    %% One shared execution contract for C++ and Python
    %% ------------------------------------------------------------------
    subgraph ENGINE["Shared execution engine"]
        direction TB
        MODULE["IAnalysisModule<br/>ABI-stable PImpl boundary"]
        LIFECYCLE["Lifecycle state machine<br/>Init → Check → Execute → Finalize → Commit"]
        PARAMS["ParamManager<br/>typed values + immutable run snapshot"]
        CONTEXT["ExecutionContext<br/>run ID · cancellation · output/cache roots"]
        CACHE["SnapshotHasher + CacheManager<br/>hit/miss decision + validation"]
        LOGGING["RunResult + status + Logger"]

        MODULE --> LIFECYCLE
        LIFECYCLE --> PARAMS
        LIFECYCLE --> CONTEXT
        LIFECYCLE --> CACHE
        LIFECYCLE --> LOGGING
    end

    REGISTRY --> MODULE
    DAG --> MODULE
    DAG -.->|parameter links| PARAMS
    WORKER --> MODULE
    PYADAPTER --> MODULE

    %% ------------------------------------------------------------------
    %% ROOT-facing services remain outside the minimal plugin header
    %% ------------------------------------------------------------------
    subgraph ANALYSIS["ROOT-facing analysis services"]
        direction TB
        ROOT["ROOT runtime"]
        MANAGER["AnalysisManager<br/>inputs · trees · cuts · metadata"]
        CLASSIC["Classic TTree loop<br/>branches + histograms"]
        RDF["RDataFrame pipeline<br/>defines · filters · snapshots"]
        PLOT["PlotManager<br/>stack · overlay · ratio · canvas"]

        ROOT --> MANAGER
        ROOT --> PLOT
        MANAGER --> CLASSIC
        MANAGER --> RDF
    end

    ROOTAPI --> ROOT
    LIFECYCLE -.->|ROOT modules only| MANAGER

    %% ------------------------------------------------------------------
    %% Transactional and reproducible outputs
    %% ------------------------------------------------------------------
    subgraph DURABLE["Durable state"]
        direction TB
        TRANSACTION["OutputTransaction<br/>staging · journal · rollback"]
        OUTPUTS[("Committed outputs")]
        MODULEPROV["Module provenance<br/>inputs · parameters · artifacts · result"]
        WORKFLOWPROV["Workflow provenance<br/>DAG nodes + module manifests"]

        TRANSACTION --> OUTPUTS --> MODULEPROV --> WORKFLOWPROV
    end

    CONTEXT --> TRANSACTION
    CACHE --> MODULEPROV
    DAG --> WORKFLOWPROV
    AMCM --> WORKFLOWPROV

    %% ------------------------------------------------------------------
    %% Visual language
    %% ------------------------------------------------------------------
    style SURFACES fill:#f8fafc,stroke:#6366f1,color:#312e81,stroke-width:1.5px;
    style APIS fill:#faf5ff,stroke:#8b5cf6,color:#581c87,stroke-width:1.5px;
    style PLUGINS fill:#f0fdf4,stroke:#10b981,color:#065f46,stroke-width:1.5px;
    style CONTROL fill:#eff6ff,stroke:#3b82f6,color:#1e3a8a,stroke-width:1.5px;
    style ENGINE fill:#f0f9ff,stroke:#0ea5e9,color:#075985,stroke-width:1.5px;
    style ANALYSIS fill:#fff7ed,stroke:#f97316,color:#9a3412,stroke-width:1.5px;
    style DURABLE fill:#fefce8,stroke:#ca8a04,color:#854d0e,stroke-width:1.5px;

    classDef surface fill:#eef2ff,stroke:#6366f1,color:#1e1b4b,stroke-width:1.5px;
    classDef adapter fill:#f5f3ff,stroke:#8b5cf6,color:#2e1065,stroke-width:1.5px;
    classDef trust fill:#ecfdf5,stroke:#10b981,color:#064e3b,stroke-width:1.5px;
    classDef control fill:#eff6ff,stroke:#3b82f6,color:#172554,stroke-width:1.5px;
    classDef engine fill:#f0f9ff,stroke:#0ea5e9,color:#0c4a6e,stroke-width:1.5px;
    classDef root fill:#fff7ed,stroke:#f97316,color:#7c2d12,stroke-width:1.5px;
    classDef durable fill:#fefce8,stroke:#ca8a04,color:#713f12,stroke-width:1.5px;

    class PYUSER,CLI,ROOTMACRO surface;
    class PYAPI,BINDING,PYADAPTER,ROOTAPI adapter;
    class PREFIXES,DISCOVERY,VERIFY,CPPABI,CPPLIB,PYIMPORT,INDEX trust;
    class AMCM,REGISTRY,DAG,WORKER control;
    class MODULE,LIFECYCLE,PARAMS,CONTEXT,CACHE,LOGGING engine;
    class ROOT,MANAGER,CLASSIC,RDF,PLOT root;
    class TRANSACTION,OUTPUTS,MODULEPROV,WORKFLOWPROV durable;
