    F1 --> F3["CacheManager + SnapshotHasher"]
    F1 --> F4["Status updates + Logger"]
    F1 --> F5["ExecutionContext<br/>run ID + cancellation + roots"]
    F5 --> F6["OutputTransaction<br/>staging + journal + rollback"]
    F6 --> F8["Module provenance<br/>artifact hashes + result"]
    B2 --> F7["Subprocess runner<br/>signal containment + result IPC"]
    F7 --> F1

