    C1 --> D1["Module factories<br/>REGISTER_MODULE"]
    C1 --> D2["Metadata providers<br/>REGISTER_MODULE_WITH_METADATA"]
    D1 --> D3["Duplicate C++ name check"]
    D3 --> E1["IAnalysisModule instances"]

