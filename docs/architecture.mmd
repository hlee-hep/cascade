flowchart TD
    %% Core entry points
    A1["Python user code"] --> A2["python/py_amcm.py<br/>py_amcm"]
    A3["ROOT macro"] --> A4["ROOT runtime"]
    A5["CLI<br/>info, doctor, module, dag, macro"] --> A4
    A5 --> A2
    A5 --> A6["Diagnostics<br/>environment and verified plugins"]
    A5 --> Z1["JSON params temp file"]
    Z1 --> A4

