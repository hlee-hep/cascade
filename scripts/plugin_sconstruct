import ast
import os, sys, hashlib, json, re
from pathlib import Path
from SCons.Script import AlwaysBuild, Environment, Glob

def hash_file(path):
    if not os.path.exists(path):
        return ""
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()[:12]

def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()

def hash_tree(paths):
    h = hashlib.sha256()
    for p in sorted(paths):
        if os.path.exists(p):
            h.update(hash_file(p).encode())
            h.update(p.encode())
    return h.hexdigest()[:12]

def patch_file(input_path, output_path, substitutions):
    if not os.path.exists(input_path):
        return
    content = Path(input_path).read_text()
    for k, v in substitutions.items():
        content = content.replace(k, v)
    Path(output_path).parent.mkdir(parents=True, exist_ok=True)
    Path(output_path).write_text(content)

def read_text(path):
    try:
        return Path(path).read_text()
    except Exception:
        return ""

def write_text(path, content):
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    Path(path).write_text(content)

def python_plugin_classes(path):
    try:
        tree = ast.parse(Path(path).read_text(), filename=str(path))
    except Exception:
        return []

    def is_base_module(base):
        if isinstance(base, ast.Name):
            return base.id == "base_module"
        if isinstance(base, ast.Attribute):
            return base.attr == "base_module"
        return False

    classes = []
    for node in tree.body:
        if isinstance(node, ast.ClassDef) and any(is_base_module(base) for base in node.bases):
            classes.append(node.name)
    return classes

def generate_manifest(target, source, env):
    language = env["CASCADE_MANIFEST_LANGUAGE"]
    entries = []
    for src in source:
        path = str(src)
        rel = os.path.basename(path)
        name = os.path.splitext(rel)[0]
        entry = {
            "name": name,
            "language": language,
            "path": rel,
            "sha256": sha256_file(path),
        }
        if language == "cpp":
            if name.startswith("lib"):
                name = name[3:]
            entry["name"] = name
        elif language == "python":
            entry["classes"] = python_plugin_classes(path)
        entries.append(entry)

    manifest = {
        "schema": 2,
        "package": env["CASCADE_PLUGIN_PACKAGE"],
        "modules": sorted(entries, key=lambda item: (item["language"], item["name"], item["path"])),
    }
    Path(str(target[0])).parent.mkdir(parents=True, exist_ok=True)
    Path(str(target[0])).write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    print(f"[SCons] generated plugin manifest {target[0]}")
    return 0

def prepare_verified_manifest(target, source, env):
    signature = str(source[0]) + ".sig"
    if os.path.exists(signature):
        os.remove(signature)
        print(f"[SCons] removed stale plugin signature {signature}")
    Path(str(target[0])).parent.mkdir(parents=True, exist_ok=True)
    Path(str(target[0])).write_text("verified\n")
    return 0

# -------- config --------
def require_env(name, default=None):
    value = os.environ.get(name, default)
    if not value:
        raise RuntimeError(f"Missing required environment variable: {name}")
    return value

prefix = os.environ.get("CASCADE_PREFIX", os.path.expanduser("~/.local"))
plugin_prefix = os.environ.get("CASCADE_PLUGIN_PREFIX", prefix)
package_name = os.environ.get("CASCADE_PLUGIN_PACKAGE", os.path.basename(os.getcwd()))
if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", package_name):
    raise RuntimeError("CASCADE_PLUGIN_PACKAGE must contain only letters, digits, '.', '_', or '-'")
pyplugin_root = os.environ.get("CASCADE_PYPLUGIN_DIR", os.path.join(plugin_prefix, "lib", "cascade", "pyplugin"))
plugin_root = os.environ.get("CASCADE_PLUGIN_DIR", os.path.join(plugin_prefix, "lib", "cascade", "plugin"))
site_packages = os.path.join(pyplugin_root, package_name)
plugin_lib_dir = os.path.join(plugin_root, package_name)
plugin_include_dir = os.path.join(
    os.environ.get("CASCADE_PLUGIN_INCLUDE_DIR", os.path.join(plugin_prefix, "include", "cascade", "plugin")),
    package_name,
)
core_inc = os.environ.get("CASCADE_CORE_INCLUDE", os.path.join(prefix, "include", "cascade"))
core_lib = os.environ.get("CASCADE_CORE_LIB", os.path.join(prefix, "lib"))
root_config = require_env("ROOT_CONFIG", "root-config")
pkg_config = require_env("PKG_CONFIG", "pkg-config")
class_map = {}
class_map_raw = os.environ.get("CASCADE_PLUGIN_CLASS_MAP", "")
if class_map_raw:
    try:
        class_map = json.loads(class_map_raw)
    except Exception as e:
        raise RuntimeError(f"Invalid CASCADE_PLUGIN_CLASS_MAP JSON: {e}")

env = Environment(ENV=os.environ, CASCADE_PLUGIN_PACKAGE=package_name)

env.ParseConfig(f'{root_config} --cflags --libs')
env.ParseConfig(f'{pkg_config} --cflags --libs yaml-cpp')
env.Append(CPPPATH=[core_inc, "include", "build/include"])
env.Append(LIBPATH=[core_lib])
env.Append(RPATH=[core_lib])
env.Append(LIBS=["AMCM", "AnalysisManager", "ParamManager", "PlotManager", "utils"])
env.AppendUnique(CXXFLAGS=["-std=c++17", "-O2", "-fvisibility=default", "-DCASCADE_PLUGIN_NO_AUTO_REGISTER"])

install_targets = []
libs = []
cpp_install = []

# -------- C++ modules --------
headers = [str(h) for h in Glob("include/*.hh")]
modules = [os.path.splitext(os.path.basename(h))[0] for h in headers]

for mod in modules:
    cc_in = f"src/{mod}.cc"
    hh_in = f"include/{mod}.hh"
    version_hash = hash_tree([cc_in, hh_in])

    subs = {
        "@BASENAME@": mod,
        "@VERSION_HASH@": f"src:{version_hash}",
    }

    cc_out = f"build/src/{mod}.cc"
    hh_out = f"build/include/{mod}.hh"
    patch_file(cc_in, cc_out, subs)
    patch_file(hh_in, hh_out, subs)

    sources = [cc_out]

    # Auto-generate ABI entry if not provided in source
    cc_text = read_text(cc_in)
    if "CascadeRegisterPlugin" not in cc_text:
        class_name = class_map.get(mod, mod)
        entry_out = f"build/src/{mod}_plugin_entry.cc"
        entry_src = f"""#include "PluginABI.hh"
#include "{mod}.hh"

CASCADE_PLUGIN_EXPORT_ABI
CASCADE_PLUGIN_EXPORT void CascadeRegisterPlugin() {{ CASCADE_REGISTER_MODULE({class_name}); }}
"""
        write_text(entry_out, entry_src)
        sources.append(entry_out)

    lib = env.SharedLibrary(mod, sources)
    libs.append(lib)

    installed_lib = env.Install(plugin_lib_dir, lib)
    install_targets += installed_lib
    cpp_install += installed_lib
    install_targets += env.Install(plugin_include_dir, [hh_out])

# -------- Python modules --------
py_srcs = [str(p) for p in Glob("python/*.py")]
py_mods = [os.path.splitext(os.path.basename(p))[0] for p in py_srcs]

py_install = []
for mod, py_in in zip(py_mods, py_srcs):
    version_hash = hash_tree([py_in])
    subs = {
        "@BASENAME@": mod,
        "@VERSION_HASH@": f"src:{version_hash}",
    }
    py_out = f"build/python/{mod}.py"
    patch_file(py_in, py_out, subs)
    py_install += env.Install(site_packages, py_out)

# __init__.py (lazy imports)
def generate_init_py(target, source, env):
    files = [str(f) for f in source if str(f).endswith(".py")]
    lines = [
        "# Auto-generated cascade plugin package __init__.py",
        "import importlib",
        "",
        "_LAZY_MODULES = {",
    ]
    for path in sorted(files):
        filename = os.path.basename(path)
        if filename == "__init__.py":
            continue
        module_name = filename[:-3]
        for class_name in python_plugin_classes(path):
            lines.append(f"    \"{class_name}\": \"{module_name}\",")
    lines += [
        "}",
        "",
        "__all__ = list(_LAZY_MODULES.keys())",
        "",
        "def __getattr__(name):",
        "    if name in _LAZY_MODULES:",
        "        mod = importlib.import_module(f\".{_LAZY_MODULES[name]}\", __name__)",
        "        obj = getattr(mod, name)",
        "        globals()[name] = obj",
        "        return obj",
        "    raise AttributeError(f\"module {__name__!r} has no attribute {name!r}\")",
    ]
    Path(str(target[0])).write_text("\n".join(lines) + "\n")
    print(f"[SCons] generated __init__.py in {site_packages}")
    return 0

init_py_target = os.path.join(site_packages, "__init__.py")
init_py = env.Command(init_py_target, py_install, generate_init_py)
install_targets.append(init_py)

manifest_targets = []
if cpp_install:
    cpp_manifest_env = env.Clone(CASCADE_MANIFEST_LANGUAGE="cpp")
    cpp_manifest = cpp_manifest_env.Command(os.path.join(plugin_lib_dir, "plugin_manifest.json"), cpp_install, generate_manifest)
    manifest_targets += cpp_manifest
    install_targets += cpp_manifest
    cpp_verified = env.Command("build/cpp_verified_install.stamp", cpp_manifest, prepare_verified_manifest)
    AlwaysBuild(cpp_verified)
    install_targets += cpp_verified

if py_install:
    py_manifest_env = env.Clone(CASCADE_MANIFEST_LANGUAGE="python")
    py_manifest = py_manifest_env.Command(os.path.join(site_packages, "plugin_manifest.json"), py_install + init_py, generate_manifest)
    manifest_targets += py_manifest
    install_targets += py_manifest
    py_verified = env.Command("build/python_verified_install.stamp", py_manifest, prepare_verified_manifest)
    AlwaysBuild(py_verified)
    install_targets += py_verified

# -------- Alias --------
Default(libs)
env.Alias("install", install_targets)
